{
  "manifest_version": 2,
  "name": "LinkedIn Feed Guard",
  "version": "1.0.0",
  "description": "Shows an orange line at the top of the LinkedIn feed, and a growing line while you scroll it.",
  "content_scripts": [
    {
      "matches": [
        "*://*.linkedin.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "linkedin-feed-guard@carlos.local",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
